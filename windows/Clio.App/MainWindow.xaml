<Window
    x:Class="Clio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Clio.Core"
    Title="Clio">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Custom title bar: content extends into the caption area, system buttons stay. -->
        <Grid x:Name="TitleBar" Grid.ColumnSpan="2">
            <TextBlock Text="Clio" VerticalAlignment="Center" Margin="12,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <Grid Grid.Row="1" Padding="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button x:Name="OpenFolderButton" Content="Open folder" Click="OnOpenFolder" Margin="0,0,0,8"
                    HorizontalAlignment="Stretch" />
            <ListView x:Name="Tree" Grid.Row="1" SelectionChanged="OnTreeSelectionChanged" />
        </Grid>

        <!-- Interim editor: stock TextBox until the custom DirectWrite editor control replaces it. -->
        <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource CanvasBrush}" CornerRadius="8,0,0,0">
            <TextBox x:Name="Editor" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="{StaticResource EditorFont}"
                     BorderThickness="0" Background="Transparent" Padding="48,40" TextChanged="OnEditorTextChanged"
                     IsSpellCheckEnabled="False" />
        </Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Padding="16,4">
            <TextBlock x:Name="WordCount" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
            <TextBlock x:Name="SaveState" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"
                       HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
