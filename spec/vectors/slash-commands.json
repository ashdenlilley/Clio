{
  "description": "Slash commands and the command palette. Derived from Clio/Contracts/ExperienceContracts.swift (ClioCommandParser, ClioCommandID), Clio/App/EditorWindowSession.swift (palette state, filtering), Clio/Editor/EditorCoordinator.swift (isInlineSlashTrigger, isEmptySlashLine), Clio/App/CommandPaletteView.swift (CommandPalettePlacement) and ClioTests/NavigationSessionTests.swift. Offsets are UTF-16 code units. Command ids and their order are the contract; palette titles and details may differ per platform only for reveal, delete, folder and search (Finder/Explorer, Trash/Recycle Bin, bookmarks/folders), so queries never use those words or substrings of them (for example 'ex' and 'exp' match Explorer on Windows). Kinds: commandToken, parse, filter, trigger, emptyLine, palette, placement.",
  "commandIds": ["new", "open", "search", "rename", "delete", "reveal", "folder", "export", "focus", "typewriter", "sidebar", "settings"],
  "vectors": [
    { "kind": "commandToken", "name": "strips slash and arguments", "input": "/export pdf", "expected": "export" },
    { "kind": "commandToken", "name": "trims and keeps case", "input": "  /Export  ", "expected": "Export" },
    { "kind": "commandToken", "name": "works without slash", "input": "export", "expected": "export" },
    { "kind": "commandToken", "name": "empty", "input": "", "expected": "" },
    { "kind": "commandToken", "name": "bare slash", "input": "/", "expected": "" },
    { "kind": "commandToken", "name": "partial", "input": "/ex pdf", "expected": "ex" },
    { "kind": "commandToken", "name": "whitespace right after slash", "input": "/\texport", "expected": "" },

    { "kind": "parse", "name": "export with format", "input": "/export pdf", "command": "export", "arguments": ["pdf"] },
    { "kind": "parse", "name": "quoted and escaped arguments", "input": "  /search \"two words\" one\\ two  ", "command": "search", "arguments": ["two words", "one two"] },
    { "kind": "parse", "name": "export format keeps its case", "input": "/export HTML", "command": "export", "arguments": ["HTML"] },
    { "kind": "parse", "name": "command is case-insensitive", "input": "/EXPORT", "command": "export", "arguments": [] },
    { "kind": "parse", "name": "adjacent single quotes join", "input": "/search 'it''s'", "command": "search", "arguments": ["its"] },
    { "kind": "parse", "name": "escaped quote inside double quotes", "input": "/search \"a\\\"b\"", "command": "search", "arguments": ["a\"b"] },
    { "kind": "parse", "name": "backslash is literal inside single quotes", "input": "/search 'a\\b'", "command": "search", "arguments": ["a\\b"] },
    { "kind": "parse", "name": "empty quotes are an argument", "input": "/search \"\"", "command": "search", "arguments": [""] },
    { "kind": "parse", "name": "docx and txt accepted", "input": "/export txt", "command": "export", "arguments": ["txt"] },
    { "kind": "parse", "name": "unsupported export format", "input": "/export rtf", "error": "invalidExportFormat", "argument": "rtf", "message": "Unsupported export format “rtf”. Use pdf, html, docx or txt." },
    { "kind": "parse", "name": "two export arguments", "input": "/export pdf html", "error": "tooManyExportArguments", "message": "Export accepts one format: pdf, html, docx or txt." },
    { "kind": "parse", "name": "unterminated quote", "input": "/search 'unfinished", "error": "unterminatedQuote", "message": "Close the quoted argument before running this command." },
    { "kind": "parse", "name": "dangling escape", "input": "/search trailing\\", "error": "danglingEscape", "message": "An argument cannot end with an escape character." },
    { "kind": "parse", "name": "missing slash", "input": "export", "error": "missingSlash", "message": "Commands begin with /." },
    { "kind": "parse", "name": "bare slash", "input": "/", "error": "missingCommand", "message": "Type a command after /." },
    { "kind": "parse", "name": "slash and spaces only", "input": "/   ", "error": "missingCommand", "message": "Type a command after /." },
    { "kind": "parse", "name": "unknown command", "input": "/bogus", "error": "unknownCommand", "argument": "bogus", "message": "Unknown command: /bogus" },

    { "kind": "filter", "name": "empty lists every command", "token": "", "expected": ["new", "open", "search", "rename", "delete", "reveal", "folder", "export", "focus", "typewriter", "sidebar", "settings"] },
    { "kind": "filter", "name": "matches id, title and detail", "token": "ext", "expected": ["open", "focus"] },
    { "kind": "filter", "name": "title word", "token": "toggle", "expected": ["focus", "typewriter", "sidebar"] },
    { "kind": "filter", "name": "word in titles", "token": "doc", "expected": ["new", "rename", "delete", "export"] },
    { "kind": "filter", "name": "exact id", "token": "focus", "expected": ["focus"] },
    { "kind": "filter", "name": "detail match", "token": "folder", "expected": ["search", "folder"] },
    { "kind": "filter", "name": "id prefix", "token": "set", "expected": ["settings"] },
    { "kind": "filter", "name": "case-insensitive", "token": "SIDE", "expected": ["sidebar"] },
    { "kind": "filter", "name": "no match", "token": "zzz", "expected": [] },
    { "kind": "filter", "name": "detail words", "token": "wri", "expected": ["typewriter", "settings"] },
    { "kind": "filter", "name": "detail across commands", "token": "caret", "expected": ["focus", "typewriter"] },

    { "kind": "trigger", "name": "slash at start of empty line", "text": "First line\n", "range": [11, 0], "replacement": "/", "expected": true },
    { "kind": "trigger", "name": "slash in prose", "text": "path", "range": [4, 0], "replacement": "/", "expected": true },
    { "kind": "trigger", "name": "slash replacing a selection", "text": "text", "range": [1, 2], "replacement": "/", "expected": true },
    { "kind": "trigger", "name": "range past the end", "text": "text", "range": [1, 9], "replacement": "/", "expected": false },
    { "kind": "trigger", "name": "start past the end", "text": "text", "range": [5, 0], "replacement": "/", "expected": false },
    { "kind": "trigger", "name": "after an emoji (UTF-16 offsets)", "text": "\uD83D\uDE42\n", "range": [3, 0], "replacement": "/", "expected": true },
    { "kind": "trigger", "name": "marked text suppresses", "text": "\uD83D\uDE42\n", "range": [3, 0], "replacement": "/", "markedText": true, "expected": false },
    { "kind": "trigger", "name": "other character", "text": "text", "range": [2, 0], "replacement": "x", "expected": false },
    { "kind": "trigger", "name": "multi-character paste", "text": "text", "range": [2, 0], "replacement": "//", "expected": false },
    { "kind": "trigger", "name": "empty document", "text": "", "range": [0, 0], "replacement": "/", "expected": true },

    { "kind": "emptyLine", "name": "empty document", "text": "", "range": [0, 0], "expected": true },
    { "kind": "emptyLine", "name": "after trailing newline", "text": "First line\n", "range": [11, 0], "expected": true },
    { "kind": "emptyLine", "name": "prose line", "text": "path", "range": [4, 0], "expected": false },
    { "kind": "emptyLine", "name": "blank line between paragraphs", "text": "a\n\nb", "range": [2, 0], "expected": true },
    { "kind": "emptyLine", "name": "spaces only line", "text": "a\n  \nb", "range": [3, 0], "expected": true },
    { "kind": "emptyLine", "name": "start of a text line", "text": "a\nb", "range": [2, 0], "expected": false },
    { "kind": "emptyLine", "name": "non-empty range", "text": "text", "range": [1, 2], "expected": false },
    { "kind": "emptyLine", "name": "start past the end", "text": "text", "range": [9, 0], "expected": false },
    { "kind": "emptyLine", "name": "line separator ends a line", "text": "a\u2028b", "range": [2, 0], "expected": false },
    { "kind": "emptyLine", "name": "blank line after line separator", "text": "a\u2028\u2028", "range": [2, 0], "expected": true },

    { "kind": "palette", "name": "two spaces escape an empty slash command", "source": "inlineSlash", "query": "/", "ops": [{ "op": "update", "query": "/  " }],
      "expected": { "presented": false, "restored": "/" } },
    { "kind": "palette", "name": "two spaces without slash also escape", "source": "inlineSlash", "query": "/", "ops": [{ "op": "update", "query": "  " }],
      "expected": { "presented": false, "restored": "/" } },
    { "kind": "palette", "name": "cancelled command is restored as typed", "source": "inlineSlash", "query": "/", "ops": [{ "op": "update", "query": "/unknown" }, { "op": "dismiss" }],
      "expected": { "presented": false, "restored": "/unknown" } },
    { "kind": "palette", "name": "restore adds the missing slash", "source": "inlineSlash", "query": "/", "ops": [{ "op": "update", "query": "unknown" }, { "op": "dismiss" }],
      "expected": { "presented": false, "restored": "/unknown" } },
    { "kind": "palette", "name": "dismiss without preserving restores nothing", "source": "inlineSlash", "query": "/", "ops": [{ "op": "update", "query": "/ex" }, { "op": "dismiss", "preserveLiteral": false }],
      "expected": { "presented": false, "restored": null } },
    { "kind": "palette", "name": "keyboard-opened palette never restores a literal", "source": "keyboardShortcut", "query": "", "ops": [{ "op": "update", "query": "export" }, { "op": "dismiss" }],
      "expected": { "presented": false, "restored": null } },
    { "kind": "palette", "name": "two spaces are input outside the inline slash", "source": "keyboardShortcut", "query": "", "ops": [{ "op": "update", "query": "  " }],
      "expected": { "presented": true, "query": "  ", "restored": null } },
    { "kind": "palette", "name": "selection is clamped to the list", "source": "keyboardShortcut", "query": "", "ops": [{ "op": "move", "by": 10000 }],
      "expected": { "presented": true, "selection": 11, "restored": null } },
    { "kind": "palette", "name": "selection clamps at the top", "source": "keyboardShortcut", "query": "", "ops": [{ "op": "move", "by": 10000 }, { "op": "move", "by": -10000 }],
      "expected": { "presented": true, "selection": 0, "restored": null } },
    { "kind": "palette", "name": "typing resets selection", "source": "keyboardShortcut", "query": "", "ops": [{ "op": "move", "by": 3 }, { "op": "update", "query": "/e" }],
      "expected": { "presented": true, "selection": 0, "restored": null } },
    { "kind": "palette", "name": "arguments keep the command selected", "source": "keyboardShortcut", "query": "/export html", "ops": [{ "op": "perform" }],
      "expected": { "presented": false, "invocation": { "command": "export", "arguments": ["html"] }, "restored": null } },
    { "kind": "palette", "name": "partial command runs without arguments", "source": "keyboardShortcut", "query": "/expo", "ops": [{ "op": "perform" }],
      "expected": { "presented": false, "invocation": { "command": "export", "arguments": [] }, "restored": null } },
    { "kind": "palette", "name": "invalid arguments stay in the palette with a message", "source": "keyboardShortcut", "query": "/export rtf", "ops": [{ "op": "perform" }],
      "expected": { "presented": true, "invocation": null, "error": "Unsupported export format “rtf”. Use pdf, html, docx or txt.", "restored": null } },
    { "kind": "palette", "name": "no match performs nothing", "source": "keyboardShortcut", "query": "/zzz", "ops": [{ "op": "perform" }],
      "expected": { "presented": true, "invocation": null, "restored": null } },

    { "kind": "placement", "name": "room below the anchor", "anchor": [200, 100, 1, 20], "window": [900, 800], "expected": [200, 128, 420, 400] },
    { "kind": "placement", "name": "compact height is limited to the window", "anchor": [200, 400, 1, 20], "window": [900, 800], "expected": [200, 428, 420, 356] },
    { "kind": "placement", "name": "flips above near the bottom and stays inside the right edge", "anchor": [880, 700, 1, 20], "window": [900, 800], "expected": [464, 292, 420, 400] },
    { "kind": "placement", "name": "tiny window is clamped", "anchor": [0, 0, 1, 10], "window": [100, 100], "expected": [16, 16, 68, 1] }
  ]
}
