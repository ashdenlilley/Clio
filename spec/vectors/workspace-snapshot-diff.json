{
  "description": "WorkspaceWatcher snapshot diff (WorkspaceWatcher.emitChanges). A snapshot is a list of files `{id, path, mtime, size}`; `id` is the physical file identity (volume + file id), `path` the standardized locator. The diff runs between the last complete snapshot and a fresh complete scan. Rules: (1) an id that vanished while a new id appeared at the SAME path is an atomic replacement and reports `modified`, never deleted/created; (2) the same id at a different path reports `moved` with `previous`; (3) the same id and path with a changed mtime or size reports `modified`; (4) remaining vanished ids report `deleted`, remaining new ids report `created`, each group sorted by path; (5) compare `events` as a multiset, except that deleted events and created events are each ordered by path. A diff with no events requests a full audit: the watcher emits `rescanRequired` for the root. Path comparison is exact on macOS and case-insensitive on Windows (scenarios marked platforms:['windows']).",
  "scenarios": [
    { "name": "identical snapshots request an audit", "previous": [ { "id": "a", "path": "/w/a.md", "mtime": 1, "size": 1 } ], "next": [ { "id": "a", "path": "/w/a.md", "mtime": 1, "size": 1 } ], "events": [], "rescanRequired": true },
    { "name": "new file is created", "previous": [], "next": [ { "id": "a", "path": "/w/a.md", "mtime": 1, "size": 1 } ], "events": [ { "kind": "created", "path": "/w/a.md" } ], "rescanRequired": false },
    { "name": "vanished file is deleted", "previous": [ { "id": "a", "path": "/w/a.md", "mtime": 1, "size": 1 } ], "next": [], "events": [ { "kind": "deleted", "path": "/w/a.md" } ], "rescanRequired": false },
    { "name": "same id at new path is moved", "previous": [ { "id": "a", "path": "/w/a.md", "mtime": 1, "size": 1 } ], "next": [ { "id": "a", "path": "/w/n/b.md", "mtime": 1, "size": 1 } ], "events": [ { "kind": "moved", "path": "/w/n/b.md", "previous": "/w/a.md" } ], "rescanRequired": false },
    { "name": "changed mtime is modified", "previous": [ { "id": "a", "path": "/w/a.md", "mtime": 1, "size": 1 } ], "next": [ { "id": "a", "path": "/w/a.md", "mtime": 2, "size": 1 } ], "events": [ { "kind": "modified", "path": "/w/a.md" } ], "rescanRequired": false },
    { "name": "changed size is modified", "previous": [ { "id": "a", "path": "/w/a.md", "mtime": 1, "size": 1 } ], "next": [ { "id": "a", "path": "/w/a.md", "mtime": 1, "size": 9 } ], "events": [ { "kind": "modified", "path": "/w/a.md" } ], "rescanRequired": false },
    { "name": "atomic replacement keeps the path and is modified", "previous": [ { "id": "a", "path": "/w/a.md", "mtime": 1, "size": 1 } ], "next": [ { "id": "b", "path": "/w/a.md", "mtime": 2, "size": 1 } ], "events": [ { "kind": "modified", "path": "/w/a.md" } ], "rescanRequired": false },
    { "name": "move and delete in one scan", "previous": [ { "id": "a", "path": "/w/a.md", "mtime": 1, "size": 1 }, { "id": "c", "path": "/w/c.md", "mtime": 1, "size": 1 } ], "next": [ { "id": "a", "path": "/w/b.md", "mtime": 1, "size": 1 } ], "events": [ { "kind": "moved", "path": "/w/b.md", "previous": "/w/a.md" }, { "kind": "deleted", "path": "/w/c.md" } ], "rescanRequired": false },
    { "name": "deleted and created are sorted by path", "previous": [ { "id": "x", "path": "/w/z.md", "mtime": 1, "size": 1 }, { "id": "y", "path": "/w/m.md", "mtime": 1, "size": 1 } ], "next": [ { "id": "p", "path": "/w/q.md", "mtime": 1, "size": 1 }, { "id": "r", "path": "/w/b.md", "mtime": 1, "size": 1 } ], "events": [ { "kind": "deleted", "path": "/w/m.md" }, { "kind": "deleted", "path": "/w/z.md" }, { "kind": "created", "path": "/w/b.md" }, { "kind": "created", "path": "/w/q.md" } ], "rescanRequired": false },
    { "name": "windows folds path case when pairing a replacement", "platforms": ["windows"], "previous": [ { "id": "a", "path": "C:/w/Note.md", "mtime": 1, "size": 1 } ], "next": [ { "id": "b", "path": "C:/w/note.md", "mtime": 2, "size": 1 } ], "events": [ { "kind": "modified", "path": "C:/w/note.md" } ], "rescanRequired": false }
  ]
}
